# GitHub Language Detection - India Tourism Project

# Frontend - JavaScript/React
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript

# Frontend - Styles
*.css linguist-language=CSS

# Frontend - Markup
*.html linguist-language=HTML
*.htm linguist-language=HTML

# Configuration Files
*.json linguist-language=JSON
*.xml linguist-language=XML
*.properties linguist-language=Properties

# Documentation
*.md linguist-language=Markdown

# Ignore generated files from statistics
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
*.lock linguist-generated=true
*.class linguist-generated=true
*.jar linguist-generated=true