# Frontend files (folder: frontend)
frontend/**/*.js linguist-language=JavaScript
frontend/**/*.jsx linguist-language=JavaScript
frontend/**/*.css linguist-language=CSS
frontend/**/*.html linguist-language=HTML
frontend/**/*.json linguist-language=JSON

# Backend files (folder: backend-spring)
backend-spring/**/*.java linguist-language=Java

# 🔥 CRITICAL: Hide compiled Java files from statistics
backend-spring/target/** linguist-vendored=true
backend-spring/.mvn/** linguist-vendored=true

# Hide node_modules
frontend/node_modules/** linguist-vendored=true

# Hide lock files
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
*.lock linguist-generated=true